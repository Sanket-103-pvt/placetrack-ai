# ==============================================================================
# PlaceTrack AI Backend - Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with your actual settings.
# ==============================================================================

# Server Port for the Express REST API (Default: 4000)
PORT=4000

# PostgreSQL Connection String (Pooled connection string for Prisma Client)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placetrack?schema=public"

# Direct PostgreSQL Connection String (Direct unpooled connection string for Prisma migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/placetrack?schema=public"

# Secret key used for signing and verifying JWT authentication tokens (Min 32 random chars in production)
JWT_SECRET="development-secret-change-me-in-production"

# Google Gemini API key used for AI-powered resume parsing and interview feedback
GEMINI_API_KEY="your-google-gemini-api-key"

# Gemini AI model identifier (Default: gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"

# Allowed Frontend Client URL for CORS and email CTA links (Default: http://localhost:3000)
FRONTEND_URL="http://localhost:3000"

# Node Environment ("development" | "production" | "test")
NODE_ENV="development"

# ==============================================================================
# Optional: SMTP Email Mailer Configuration (For drive notifications & deadline reminders)
# ==============================================================================

# SMTP server hostname (e.g. smtp.gmail.com or smtp.mailtrap.io)
SMTP_HOST="smtp.mailtrap.io"

# SMTP server port (587 for TLS, 465 for SSL, or 2525)
SMTP_PORT=2525

# Username for SMTP authentication
SMTP_USER="your-smtp-username"

# Password for SMTP authentication
SMTP_PASS="your-smtp-password"

# Sender address displayed in outgoing email notifications
EMAIL_FROM="PlaceTrack AI <notifications@placetrack.ai>"

# ==============================================================================
# Optional: Cloudinary Storage Configuration (For company logo uploads)
# ==============================================================================

# Cloudinary account cloud name
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# Cloudinary API key
CLOUDINARY_API_KEY="your-cloudinary-api-key"

# Cloudinary API secret
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Unsigned upload preset name configured in Cloudinary dashboard
CLOUDINARY_UPLOAD_PRESET="your-cloudinary-upload-preset"
